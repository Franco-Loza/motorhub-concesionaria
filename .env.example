# ===================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO (TEMPLATE)
# ===================================================
# Renombrar este archivo a .env.local y completar con tus credenciales reales.

# Base de Datos (SQLite para desarrollo local o PostgreSQL de Supabase)
DATABASE_URL="file:./dev.db"
# Para Supabase PostgreSQL (descomentar y configurar):
# DATABASE_URL="postgresql://postgres.[USER]:[PASSWORD]@[HOST]:6543/postgres?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[USER]:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# Clave secreta JWT para firma de sesiones
JWT_SECRET="tu_clave_secreta_jwt_aqui_generada_aleatoriamente"

# Configuración de Cloudinary (Subida de fotos de vehículos)
CLOUDINARY_CLOUD_NAME="tu_cloudinary_cloud_name"
CLOUDINARY_API_KEY="tu_cloudinary_api_key"
CLOUDINARY_API_SECRET="tu_cloudinary_api_secret"

# Servidor de correos y contacto empresarial
BUSINESS_EMAIL="consultas@tudominio.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="tu-correo@gmail.com"
SMTP_PASSWORD="tu-clave-de-aplicacion"

# Integración Oficial con Mercado Libre (Argentina)
# Se pueden configurar aquí o directamente desde el panel /panel/mercadolibre
MERCADOLIBRE_APP_ID="tu_mercadolibre_client_id"
MERCADOLIBRE_CLIENT_SECRET="tu_mercadolibre_client_secret"
MERCADOLIBRE_REDIRECT_URI="http://localhost:3000/api/mercadolibre/callback"
